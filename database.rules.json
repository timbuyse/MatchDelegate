{
  "rules": {

    "teams": {
      // Eigenaar mag alle ploegen lezen voor het globaal gebruikersoverzicht.
      ".read": "auth != null && root.child('owner').val() === auth.uid",

      "$teamId": {

        // Lezen: leden van de ploeg, de eigenaar (globaal overzicht), of de clubbeheerder van de
        // club waartoe deze ploeg behoort (fase 2d).
        ".read": "auth != null && (root.child('teams/' + $teamId + '/members/' + auth.uid).exists() || root.child('owner').val() === auth.uid || root.child('clubs/' + root.child('teams/' + $teamId + '/info/clubId').val() + '/admins/' + auth.uid).exists())",

        // Nieuwe ploeg aanmaken: team bestaat nog niet + gebruiker zet zichzelf als admin
        //   EN is eigenaar of goedgekeurd beheerder; OF de clubbeheerder maakt ze aan in zijn club (fase 2d).
        // Bestaande ploeg aanpassen: bestaande admin of clubbeheerder van de club (fase 2d), MAAR
        //   de clubId moet daarbij ongewijzigd blijven (newData is bij elke — ook diepe — write de
        //   projectie van de hele teamboom ná de write, dus dit dekt óók een gerichte remove() van
        //   info/clubId; de .validate op clubId zelf draait niet bij verwijderen). Enkel de eigenaar
        //   verplaatst een ploeg naar een andere club of maakt ze club-loos.
        // Verwijderen: eigenaar (alle teams) of goedgekeurde beheerder die ook maker is (createdBy) —
        //   de clubbeheerder mag NIET hard verwijderen (enkel archiveren = een gewone aanpassing).
        ".write": "auth != null && (root.child('owner').val() === auth.uid || (!data.exists() && newData.child('members').child(auth.uid).val() === 'admin' && root.child('approvedAdmins/' + auth.uid).exists()) || (!data.exists() && root.child('clubs/' + newData.child('info/clubId').val() + '/admins/' + auth.uid).exists()) || (data.exists() && newData.exists() && newData.child('info/clubId').val() === data.child('info/clubId').val() && (root.child('teams/' + $teamId + '/members/' + auth.uid).val() === 'admin' || root.child('clubs/' + root.child('teams/' + $teamId + '/info/clubId').val() + '/admins/' + auth.uid).exists())) || (data.exists() && !newData.exists() && root.child('approvedAdmins/' + auth.uid).exists() && data.child('info/createdBy').val() === auth.uid))",

        "members": {
          // Admin (of de clubbeheerder van de club, fase 2d) mag leden beheren.
          ".write": "auth != null && (root.child('teams/' + $teamId + '/members/' + auth.uid).val() === 'admin' || root.child('clubs/' + root.child('teams/' + $teamId + '/info/clubId').val() + '/admins/' + auth.uid).exists())",

          "$memberId": {
            // Een gebruiker mag ALTIJD zijn eigen lidmaatschap lezen (ook vóór hij lid is),
            // zodat hij bij het vervoegen kan checken of hij al lid is.
            ".read": "auth != null && $memberId === auth.uid",

            // Nieuw lid mag zichzelf toevoegen als viewer (via uitnodiging); een lid mag zijn
            // eigen lidmaatschap altijd weer verwijderen (account verwijderen/ploeg verlaten);
            // beheerder OF de clubbeheerder van de club mag de rol van elk lid aanpassen (promote/demote).
            //
            // VERWIJDERD BLIJFT VERWIJDERD (v1.9.2). Zelf-toevoegen controleert géén uitnodiging —
            // enkel of je het ploeg-id kent, en dat staat in elke uitnodigingslink. Wie je uit de
            // ploeg zette, kon zich daarmee dus meteen weer toevoegen, en het token intrekken hielp
            // niet omdat er niet naar het token gekeken wordt. De extra voorwaarde hieronder geldt
            // ALLEEN voor de zelf-toevoegtak: een beheerder mag iemand nog gewoon toevoegen (dat
            // haalt hem ook van de lijst, zie herstelToegang/promoteMember in views-account.js), en
            // zichzelf verwijderen blijft altijd mogelijk.
            ".write": "auth != null && (($memberId === auth.uid && !data.exists() && newData.val() === 'viewer' && !root.child('teams/' + $teamId + '/removed/' + auth.uid).exists()) || ($memberId === auth.uid && !newData.exists()) || root.child('teams/' + $teamId + '/members/' + auth.uid).val() === 'admin' || root.child('clubs/' + root.child('teams/' + $teamId + '/info/clubId').val() + '/admins/' + auth.uid).exists())"
          }
        },

        // Wie een beheerder bewust uit de ploeg zette. Bevat naam, e-mail en het tijdstip, zodat de
        // ledenlijst kan tonen wie er geweerd is en de beheerder de toegang met één tik kan
        // herstellen. Enkel beheerders (en de clubbeheerder/eigenaar) schrijven hier; de betrokkene
        // mag zijn eigen entry lezen zodat de app een nette melding kan geven i.p.v. een kale
        // rechtenfout — precies dezelfde opzet als members/$memberId hierboven.
        "removed": {
          ".read":  "auth != null && (root.child('teams/' + $teamId + '/members/' + auth.uid).val() === 'admin' || root.child('owner').val() === auth.uid || root.child('clubs/' + root.child('teams/' + $teamId + '/info/clubId').val() + '/admins/' + auth.uid).exists())",
          ".write": "auth != null && (root.child('teams/' + $teamId + '/members/' + auth.uid).val() === 'admin' || root.child('owner').val() === auth.uid || root.child('clubs/' + root.child('teams/' + $teamId + '/info/clubId').val() + '/admins/' + auth.uid).exists())",
          "$removedId": {
            ".read": "auth != null && $removedId === auth.uid"
          }
        },

        // DE KERN, OOK VOOR EEN BEHEERDER VAN EEN ZUSTERPLOEG (v1.17.0). Bovenop de .read op $teamId
        // hierboven (leden, eigenaar, clubbeheerder): wie beheerder is van een ANDERE ploeg van
        // DEZELFDE club mag hier lezen. Zo kan hij bij het samenstellen van een selectie een speler
        // van de zusterploeg bijzetten als gast, met behoud van de koppeling naar die speler.
        //
        // Dit opent enkel de kern-node: namen, rugnummers en posities van de spelers, plus de
        // ploegnaam/verantwoordelijke/trainers die in dezelfde node staan. Wedstrijden, notities en
        // ledenlijsten blijven dicht, en over de clubgrens heen verandert er niets.
        //
        // De lezing gaat via de uid-index users/$uid/clubTeam/$clubId (zie daar): die noemt de ploeg
        // waarvan de lezer beheerder beweert te zijn, en hier wordt die bewering nagerekend — hij moet
        // er NU beheerder van zijn, en die ploeg moet in DEZELFDE club zitten als de ploeg die gelezen
        // wordt. Een verouderde of verzonnen indexvermelding levert dus niets op.
        "roster": {
          ".read": "auth != null && root.child('teams/' + $teamId + '/info/clubId').exists() && root.child('teams/' + root.child('users/' + auth.uid + '/clubTeam/' + root.child('teams/' + $teamId + '/info/clubId').val()).val() + '/members/' + auth.uid).val() === 'admin' && root.child('teams/' + root.child('users/' + auth.uid + '/clubTeam/' + root.child('teams/' + $teamId + '/info/clubId').val()).val() + '/info/clubId').val() === root.child('teams/' + $teamId + '/info/clubId').val()"
        },

        "info": {
          "clubId": {
            // De clubId van een ploeg ligt vast na aanmaken (fase 2d hardening): enkel de eigenaar
            // mag ze wijzigen (= een ploeg naar een andere club verplaatsen). Een ploegbeheerder
            // kan zo het clubtoezicht niet afschudden of een ploeg in een vreemde club planten;
            // bij aanmaken moet de maker clubbeheerder zijn van de opgegeven club.
            ".validate": "root.child('owner').val() === auth.uid || (data.exists() && newData.val() === data.val()) || (!data.exists() && root.child('clubs/' + newData.val() + '/admins/' + auth.uid).exists())"
          },

          // TWEE VELDJES VAN EEN ZUSTERPLOEG (v1.17.3), met exact dezelfde nagerekende bewering als
          // bij `roster` hierboven. Enkel deze twee, niet de hele info-node:
          //   name     — om de ploeg bij haar echte naam te tonen in de keuzelijst, ook na een
          //              hernoeming (de naam die in de kern bewaard zit, kan verouderd zijn);
          //   archived — om een door de club gearchiveerde ploeg NIET als bron van gastspelers aan te
          //              bieden; ze is overal elders in de app verborgen.
          // Waarom apart en niet op `info` zelf: een leesrecht op een kind geeft geen leesrecht op de
          // ouder, en dat is hier net de bedoeling — clubId, clubName, statsPublic en createdBy
          // blijven dicht voor wie geen lid van die ploeg is.
          "name": {
            ".read": "auth != null && root.child('teams/' + $teamId + '/info/clubId').exists() && root.child('teams/' + root.child('users/' + auth.uid + '/clubTeam/' + root.child('teams/' + $teamId + '/info/clubId').val()).val() + '/members/' + auth.uid).val() === 'admin' && root.child('teams/' + root.child('users/' + auth.uid + '/clubTeam/' + root.child('teams/' + $teamId + '/info/clubId').val()).val() + '/info/clubId').val() === root.child('teams/' + $teamId + '/info/clubId').val()"
          },
          "archived": {
            ".read": "auth != null && root.child('teams/' + $teamId + '/info/clubId').exists() && root.child('teams/' + root.child('users/' + auth.uid + '/clubTeam/' + root.child('teams/' + $teamId + '/info/clubId').val()).val() + '/members/' + auth.uid).val() === 'admin' && root.child('teams/' + root.child('users/' + auth.uid + '/clubTeam/' + root.child('teams/' + $teamId + '/info/clubId').val()).val() + '/info/clubId').val() === root.child('teams/' + $teamId + '/info/clubId').val()"
          }
        }
      }
    },

    "memberInfo": {
      // Eigenaar mag alle memberInfo lezen voor het globaal gebruikersoverzicht.
      ".read": "auth != null && root.child('owner').val() === auth.uid",

      "$teamId": {
        // Beheerder van de ploeg leest de volledige ledenlijst, de eigenaar, of de clubbeheerder
        // van de club waartoe deze ploeg behoort (fase 2d).
        ".read":  "auth != null && (root.child('teams/' + $teamId + '/members/' + auth.uid).val() === 'admin' || root.child('owner').val() === auth.uid || root.child('clubs/' + root.child('teams/' + $teamId + '/info/clubId').val() + '/admins/' + auth.uid).exists())",
        ".write": "auth != null && (root.child('owner').val() === auth.uid || root.child('teams/' + $teamId + '/members/' + auth.uid).val() === 'admin' || root.child('clubs/' + root.child('teams/' + $teamId + '/info/clubId').val() + '/admins/' + auth.uid).exists())",
        "$memberId": {
          // Elk lid leest/schrijft enkel zijn eigen info, en enkel als hij lid is.
          ".read":  "auth != null && $memberId === auth.uid",
          ".write": "auth != null && $memberId === auth.uid && root.child('teams/' + $teamId + '/members/' + auth.uid).exists()",
          "verified": {
            // Hierop steunt de ploegbeheerder bij het promoveren van een lid: hij mag de
            // e-mailindex niet lezen (owner-only), dus dit is zijn enige signaal of de naam in
            // zijn ledenlijst ergens op steunt. Schrijf je je eigen entry, dan moet dit veld
            // exact overeenkomen met email_verified in je token — anders kan je jezelf hier als
            // bevestigd neerzetten en zo alsnog de promotie krijgen die voor iemand anders
            // bedoeld was. Laat je het weg, dan geldt "niet bevestigd" (de veilige kant).
            ".validate": "auth.uid !== $memberId || newData.val() === auth.token.email_verified"
          }
        }
      }
    },

    "users": {
      "$userId": {
        ".read":  "auth != null && (auth.uid === $userId || root.child('owner').val() === auth.uid)",
        ".write": "auth != null && auth.uid === $userId",
        "clubs": {
          // Clubmodel (fase 3): de gebruiker beheert zijn eigen club-index, en de app-eigenaar mag
          // ze ook schrijven om iemand als clubbeheerder aan te stellen (omgekeerde index).
          ".write": "auth != null && (auth.uid === $userId || root.child('owner').val() === auth.uid)"
        },
        "teams": {
          // De app-eigenaar mag de omgekeerde ploeg-index van een gebruiker schrijven om rechtstreeks
          // een ploegbeheerder aan te stellen (fase 2d). De gebruiker zelf schrijft ze sowieso al.
          ".write": "auth != null && (auth.uid === $userId || root.child('owner').val() === auth.uid)"
        },

        // ZUSTERPLOEGEN BINNEN DEZELFDE CLUB (v1.17.0). Een ploegbeheerder mag de KERN van de andere
        // ploegen van zijn eigen club inkijken, zodat hij een speler die komt meehelpen als gast kan
        // bijzetten met behoud van de koppeling (i.p.v. hem als naamloze "losse speler" te typen).
        //
        // De regels kunnen niet over de ploegen van een gebruiker itereren, dus is er een index op
        // uid nodig: clubTeam/$clubId = het teamId waarvan deze gebruiker beheerder beweert te zijn.
        // De .validate hieronder controleert die bewering bij het SCHRIJVEN; de leesregels op
        // clubs/$clubId/teams en teams/$teamId/roster controleren ze nog eens bij het LEZEN. Die
        // tweede controle is wat telt: raakt iemand zijn beheerdersrol kwijt en blijft dit vermelding
        // hier staan, dan levert ze niets meer op. Een verouderde index geeft dus geen toegang.
        //
        // Bij verwijderen draait .validate niet — zijn eigen vermelding wissen mag altijd.
        "clubTeam": {
          "$clubId": {
            ".validate": "root.child('teams/' + newData.val() + '/members/' + auth.uid).val() === 'admin' && root.child('teams/' + newData.val() + '/info/clubId').val() === $clubId"
          }
        }
      }
    },

    "owner": {
      // Iedereen die ingelogd is kan lezen wie de eigenaar is.
      // Schrijven kan enkel zolang er nog GEEN eigenaar is (eenmalig claimen).
      ".read":  "auth != null",
      ".write": "auth != null && !data.exists()"
    },

    "approvedAdmins": {
      // Enkel de eigenaar beheert de lijst van goedgekeurde beheerders.
      ".read":  "auth != null && root.child('owner').val() === auth.uid",
      ".write": "auth != null && root.child('owner').val() === auth.uid",
      "$uid": {
        // Elke gebruiker mag zijn eigen goedkeuringsstatus lezen.
        ".read": "auth != null && auth.uid === $uid",
        // Een gebruiker mag zijn EIGEN entry enkel VERWIJDEREN (niet aanmaken/wijzigen) —
        // nodig bij accountverwijdering, anders blijft naam+e-mail hier permanent staan
        // gekoppeld aan een uid die niet meer bestaat.
        ".write": "auth != null && auth.uid === $uid && !newData.exists()"
      }
    },

    "adminRequests": {
      // Eigenaar leest/beheert alle aanvragen.
      ".read":  "auth != null && root.child('owner').val() === auth.uid",
      ".write": "auth != null && root.child('owner').val() === auth.uid",
      "$uid": {
        // Een gebruiker mag enkel zijn eigen aanvraag lezen/schrijven.
        ".read":  "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "invites": {
      "$token": {
        ".read": "auth != null",
        // Aanmaken: teamadmin van de betrokken ploeg (of eigenaar). Bij het overschrijven
        // van een BESTAAND token moet je bovendien ook admin zijn van de ploeg waar dat
        // token al aan toebehoorde — anders zou een admin van ploeg A het token van ploeg B
        // kunnen kapen door het te overschrijven met teamId=A (enkel A's adminschap werd
        // dan gecontroleerd, nooit B's). Verwijderen (bv. bij regenereren van de code): de
        // oorspronkelijke maker OF elke huidige teamadmin van die ploeg — niet enkel wie
        // het token ooit zelf aanmaakte.
        ".write": "auth != null && (root.child('owner').val() === auth.uid || (newData.exists() && root.child('teams/' + newData.child('teamId').val() + '/members/' + auth.uid).val() === 'admin' && (!data.exists() || root.child('teams/' + data.child('teamId').val() + '/members/' + auth.uid).val() === 'admin')) || (!newData.exists() && (data.child('createdBy').val() === auth.uid || root.child('teams/' + data.child('teamId').val() + '/members/' + auth.uid).val() === 'admin')) || (newData.exists() && root.child('clubs/' + root.child('teams/' + newData.child('teamId').val() + '/info/clubId').val() + '/admins/' + auth.uid).exists() && (!data.exists() || root.child('clubs/' + root.child('teams/' + data.child('teamId').val() + '/info/clubId').val() + '/admins/' + auth.uid).exists())) || (!newData.exists() && root.child('clubs/' + root.child('teams/' + data.child('teamId').val() + '/info/clubId').val() + '/admins/' + auth.uid).exists()))"
      }
    },

    "maintenance": {
      // Iedereen die ingelogd is mag lezen (om onderhoudsmodus te detecteren).
      // Enkel de eigenaar mag schrijven.
      ".read":  "auth != null",
      ".write": "auth != null && root.child('owner').val() === auth.uid"
    },

    "rejectedAdmins": {
      "$uid": {
        ".read":  "auth != null && auth.uid === $uid",
        ".write": "auth != null && (root.child('owner').val() === auth.uid || auth.uid === $uid)"
      }
    },

    "teamAdminRequests": {
      "$teamId": {
        ".read": "auth != null && (root.child('owner').val() === auth.uid || root.child('teams/' + $teamId + '/members/' + auth.uid).val() === 'admin' || root.child('clubs/' + root.child('teams/' + $teamId + '/info/clubId').val() + '/admins/' + auth.uid).exists())",
        ".write": "auth != null && (root.child('owner').val() === auth.uid || root.child('teams/' + $teamId + '/members/' + auth.uid).val() === 'admin' || root.child('clubs/' + root.child('teams/' + $teamId + '/info/clubId').val() + '/admins/' + auth.uid).exists())",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && root.child('teams/' + $teamId + '/members/' + auth.uid).val() === 'viewer'"
        }
      }
    },

    "teamNotes": {
      // Notities (wedstrijd + per speler) apart van "matches" gehouden zodat kijkers/gasten
      // ze nooit kunnen lezen, ook niet rechtstreeks via Firebase (in tegenstelling tot
      // teams/$teamId/matches, dat voor elk teamlid leesbaar is). Toegang: beheerder van de ploeg,
      // de eigenaar, of de clubbeheerder van de club waartoe de ploeg behoort (fase 2d schijf 3).
      "$teamId": {
        ".read":  "auth != null && (root.child('teams/' + $teamId + '/members/' + auth.uid).val() === 'admin' || root.child('owner').val() === auth.uid || root.child('clubs/' + root.child('teams/' + $teamId + '/info/clubId').val() + '/admins/' + auth.uid).exists())",
        ".write": "auth != null && (root.child('teams/' + $teamId + '/members/' + auth.uid).val() === 'admin' || root.child('owner').val() === auth.uid || root.child('clubs/' + root.child('teams/' + $teamId + '/info/clubId').val() + '/admins/' + auth.uid).exists())"
      }
    },

    "deletedMatches": {
      // Backup van een verwijderde wedstrijd (vangnet tegen abusievelijk verwijderen).
      // Zelfde rechten als teamNotes: beheerder(s) van die ploeg, de eigenaar, of de clubbeheerder.
      "$teamId": {
        ".read":  "auth != null && (root.child('teams/' + $teamId + '/members/' + auth.uid).val() === 'admin' || root.child('owner').val() === auth.uid || root.child('clubs/' + root.child('teams/' + $teamId + '/info/clubId').val() + '/admins/' + auth.uid).exists())",
        ".write": "auth != null && (root.child('teams/' + $teamId + '/members/' + auth.uid).val() === 'admin' || root.child('owner').val() === auth.uid || root.child('clubs/' + root.child('teams/' + $teamId + '/info/clubId').val() + '/admins/' + auth.uid).exists())"
      }
    },

    "deletedTeams": {
      // Enkel eigenaar mag alle backups lezen en herstellen.
      ".read":  "auth != null && root.child('owner').val() === auth.uid",
      ".write": "auth != null && root.child('owner').val() === auth.uid",
      "$teamId": {
        // Beheerder mag backup schrijven van zijn eigen team bij verwijderen.
        ".write": "auth != null && (root.child('owner').val() === auth.uid || root.child('teams/' + $teamId + '/members/' + auth.uid).val() === 'admin')"
      }
    },

    "usersByEmail": {
      // E-mail->uid index (fase 3) zodat de eigenaar een clubbeheerder op e-mailadres kan
      // aanstellen, ook voor iemand die (nog) geen ploeg vervoegd heeft. Enkel de eigenaar leest
      // de volledige index. Elke gebruiker schrijft ENKEL zijn eigen entry, en enkel met zijn
      // eigen (door Firebase geverifieerde) e-mailadres — zo kan niemand andermans e-mail claimen.
      // Zelf verwijderen (bij accountverwijdering) mag ook.
      //
      // `verified` moet exact overeenkomen met email_verified in het token: registreren met een
      // e-mailadres kan iedereen (Firebase controleert dat niet), maar de app stelt een club- of
      // ploegbeheerder aan OP e-mailadres en gebruikt deze index om dat adres bij een account te
      // brengen. Zonder deze clausule kon iemand zich met het adres van een ander registreren,
      // zich hier als bevestigd voordoen en zo diens aanstelling opvangen. Het scherm controleert
      // het ook, maar dat alleen is niets waard — dit is de laag die het echt dichthoudt.
      ".read": "auth != null && root.child('owner').val() === auth.uid",
      "$uid": {
        ".read":  "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && (!newData.exists() || (newData.child('email').val() === auth.token.email && newData.child('verified').val() === auth.token.email_verified))"
      }
    },

    "clubs": {
      // FASE 1 (clubmodel-fundament). Een club groepeert meerdere ploegen. Voorlopig schrijft
      // ENKEL de app-eigenaar (die maakt clubs aan en stelt clubbeheerders aan). Clubbeheerders
      // mogen hun eigen club al lezen; hun schrijfrechten (ploegen beheren binnen de club) komen
      // in fase 2 met fijnmazige sub-rules zodat een clubbeheerder niet zijn eigen admins-lijst
      // kan bewerken.
      // Eigenaar leest alle clubs voor het globaal overzicht.
      ".read":  "auth != null && root.child('owner').val() === auth.uid",
      "$clubId": {
        // Lezen: clubbeheerder van deze club, of de eigenaar.
        ".read":  "auth != null && (root.child('clubs/' + $clubId + '/admins/' + auth.uid).exists() || root.child('owner').val() === auth.uid)",
        // Schrijven op clubniveau (info + admins): enkel de eigenaar. Zo kan een clubbeheerder
        // zichzelf niet uit de admins verwijderen of anderen toevoegen.
        ".write": "auth != null && root.child('owner').val() === auth.uid",
        "info": {
          "logo": {
            // Het clublogo mag ook door de clubbeheerder van deze club gewijzigd/verwijderd worden.
            // Naam en admins blijven owner-only (via de $clubId .write hierboven).
            ".write": "auth != null && (root.child('owner').val() === auth.uid || root.child('clubs/' + $clubId + '/admins/' + auth.uid).exists())"
          }
        },
        "admins": {
          "$adminUid": {
            // Een clubbeheerder mag enkel ZIJN EIGEN entry VERWIJDEREN (opkuis bij account-
            // verwijdering) — geen ghost-uid in "Clubs beheren". Toevoegen/wijzigen (ook van
            // zichzelf) blijft owner-only via de $clubId .write hierboven.
            ".write": "auth != null && auth.uid === $adminUid && !newData.exists()"
          }
        },
        "teams": {
          // De ploeg-index binnen de club mag ook door de clubbeheerder beheerd worden (fase 2d),
          // zodat hij ploegen kan aanmaken/registreren in zijn club. (Niet info of admins.)
          ".write": "auth != null && (root.child('owner').val() === auth.uid || root.child('clubs/' + $clubId + '/admins/' + auth.uid).exists())",

          // Lezen mag ook een gewone PLOEGBEHEERDER binnen deze club (v1.17.0): hij moet de
          // zusterploegen kunnen opsommen vóór hij er een speler uit kan bijzetten. Enkel deze lijst
          // van ploeg-id's — info en admins van de club blijven dicht. Dezelfde nagerekende bewering
          // als bij teams/$teamId/roster, zie de uitleg daar en bij users/$uid/clubTeam.
          ".read": "auth != null && root.child('teams/' + root.child('users/' + auth.uid + '/clubTeam/' + $clubId).val() + '/members/' + auth.uid).val() === 'admin' && root.child('teams/' + root.child('users/' + auth.uid + '/clubTeam/' + $clubId).val() + '/info/clubId').val() === $clubId"
        }
      }
    },

    "presence": {
      // WIE HEEFT DE APP OPEN (v1.19.0). Elk toestel legt hier een briefje neer zodra de app opent,
      // en Firebase ruimt dat zelf op wanneer de verbinding wegvalt (onDisconnect). Er staat GEEN
      // naam in: enkel een tijdstip, de wedstrijd die open staat en de rol. De namen komen uit
      // usersByEmail, dat enkel de eigenaar leest.
      //
      // Lezen: de eigenaar leest alles (zijn overzicht "Nu online"). Per ploeg leest ook de
      // ploegbeheerder en de clubbeheerder — dat voedt de teller "N volgen mee" op het
      // wedstrijdscherm. Een KIJKER mag hier niet lezen: hij heeft er niets aan, en het gaat over
      // ouders die meekijken.
      ".read": "auth != null && root.child('owner').val() === auth.uid",
      "$teamId": {
        ".read": "auth != null && (root.child('teams/' + $teamId + '/members/' + auth.uid).val() === 'admin' || root.child('owner').val() === auth.uid || root.child('clubs/' + root.child('teams/' + $teamId + '/info/clubId').val() + '/admins/' + auth.uid).exists())",
        "$uid": {
          // Schrijven: enkel je eigen briefjes. Niemand kan iemand anders online of offline zetten.
          ".read":  "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          "$sessionId": {
            // Het tijdstip mag niet in de toekomst liggen. Zonder deze clausule kon iemand zichzelf
            // een tijdstempel van volgend jaar geven en zo eeuwig als "online" in de lijst blijven
            // staan — de verse-drempel van de app hangt volledig aan dit getal.
            ".validate": "newData.hasChild('t') && newData.child('t').isNumber() && newData.child('t').val() <= now"
          }
        }
      }
    },

    "lastSeen": {
      // Wanneer opende deze persoon de app voor het laatst (v1.19.0)? Eén getal per account, dat de
      // gebruiker zelf schrijft bij het openen. Voedt "vandaag/deze week actief" bij Alle gebruikers.
      // Enkel de eigenaar leest de volledige lijst; iedereen leest en schrijft zijn eigen getal.
      ".read": "auth != null && root.child('owner').val() === auth.uid",
      "$uid": {
        ".read":  "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "!newData.exists() || (newData.isNumber() && newData.val() <= now)"
      }
    },

    "usage": {
      // GEBRUIKSCIJFERS. Per dag, per soort gebruiker, per persoon, per bezoek één tijdstip:
      //   usage/<dag>/<soort>/<uid>/<sessie> = tijdstip
      // Dat is genoeg om bezoekers (verschillende uid's) en sessies (verschillende bezoeken) te
      // tellen over een dag, een week en een maand, zonder dat er ooit iets opgeteld of verhoogd
      // moet worden — een teller die twee toestellen tegelijk verhogen zou stilletjes mislopen.
      // Er staat GEEN naam, geen ploeg en geen wedstrijd in: dit is een teller, geen logboek.
      //
      // Lezen en opkuisen: enkel de eigenaar (het scherm "Gebruikscijfers" in App-beheer, dat ook de
      // dagen ouder dan zes weken opruimt). Schrijven: enkel je eigen briefjes, en enkel onder je
      // eigen uid — niemand kan de cijfers van iemand anders aandikken.
      ".read":  "auth != null && root.child('owner').val() === auth.uid",
      ".write": "auth != null && root.child('owner').val() === auth.uid",
      "$dag": {
        "$soort": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            // De dagsleutel moet een datum zijn (anders groeit de tak vol met verzonnen sleutels die
            // het opkuisen op datum nooit meer te pakken krijgt), en een GAST kan zichzelf niet in de
            // accountkolom zetten. Die tweede clausule staat bewust omgekeerd geformuleerd: is de
            // herkomst van de aanmelding om welke reden dan ook niet af te lezen, dan blijft het
            // gewone schrijven werken en valt enkel deze extra bescherming weg — een teller die
            // zwijgt is hier erger dan een gast die één wegwerp-account in de verkeerde kolom zet.
            ".write": "auth != null && auth.uid === $uid && ($soort === 'a' || $soort === 'g') && $dag.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && !($soort === 'a' && auth.token.firebase.sign_in_provider === 'anonymous')",
            "$sessie": {
              // Eén getal per bezoek, en niet in de toekomst — net als bij de aanwezigheid: anders
              // kan iemand zich een tijdstempel van volgend jaar geven.
              ".validate": "newData.isNumber() && newData.val() <= now && $sessie.matches(/^[a-z0-9]{1,32}$/)"
            }
          }
        }
      }
    },

    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
